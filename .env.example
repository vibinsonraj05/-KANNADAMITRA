# Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: override the default model
GEMINI_MODEL=gemini-3.5-flash-lite
# Translation fallback used if the primary model is temporarily unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# MongoDB Atlas connection string (keep private and server-side).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional: database name (defaults to kannada_mitra).
MONGODB_DB=kannada_mitra
# Optional: secret for signing session cookies (min 32 chars). Generated automatically if not provided.
AUTH_SECRET=your-random-32-character-session-secret-here

